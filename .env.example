# Copy to .env and adjust. Every key is optional.

# Dashboard bind address (use 0.0.0.0 inside Docker)
BUGHUNTER_HOST=127.0.0.1
BUGHUNTER_PORT=8000
BUGHUNTER_PLAYGROUND_API_PORT=8001
BUGHUNTER_PLAYGROUND_WEB_PORT=8002
BUGHUNTER_LOG_LEVEL=INFO

# Test execution
BUGHUNTER_REQUEST_TIMEOUT=15
BUGHUNTER_DEFAULT_SLA_MS=500
# After an approved patch, wait this long for an auto-reloading target to restart
BUGHUNTER_PATCH_SETTLE_SECONDS=1.5
BUGHUNTER_PATCH_READY_TIMEOUT=15
# Only files under these directories may be patched (os.pathsep separated)
BUGHUNTER_PATCH_ROOTS=.

# Run history and exported reports
BUGHUNTER_REPORTS_DIR=reports

# Protect the dashboard API (strongly recommended whenever HOST is not 127.0.0.1).
# The dashboard asks for this token once per browser session.
BUGHUNTER_API_TOKEN=
# Show "Hesap oluştur" on the login screen (the first account can always be created)
BUGHUNTER_ALLOW_SIGNUP=true

# E-mailing reports ("Rapor gönder"). Gmail: smtp.gmail.com, 587, and an app password.
BUGHUNTER_SMTP_HOST=
BUGHUNTER_SMTP_PORT=587
BUGHUNTER_SMTP_USER=
BUGHUNTER_SMTP_PASSWORD=
BUGHUNTER_SMTP_FROM=
# starttls (port 587) | ssl (port 465) | none
BUGHUNTER_SMTP_SECURITY=starttls
# Address used by the e-mail's "Raporu görüntüle" button (default http://HOST:PORT)
BUGHUNTER_PUBLIC_URL=
BUGHUNTER_SHARE_LINK_DAYS=30

# Local RAG
BUGHUNTER_OLLAMA_URL=http://127.0.0.1:11434
BUGHUNTER_RAG_DB=run_artifacts/rag
BUGHUNTER_RAG_CHAT_MODEL=qwen3.5
BUGHUNTER_RAG_EMBED_MODEL=embeddinggemma
